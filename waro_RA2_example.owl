<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://purl.org/waro/waro.owl"
         xmlns="http://purl.org/waro/waro.owl#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#">

<owl:Ontology rdf:about="http://purl.org/waro/waro.owl"/>

<owl:ObjectProperty rdf:about="#hasComponent">
  <rdfs:domain rdf:resource="#WebApplication"/>
  <rdfs:range rdf:resource="#Component"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hostedOn">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Component"/>
  <rdfs:range rdf:resource="#Host"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#reaches">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:range rdf:resource="#Host"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#connectsTo">
  <rdfs:subPropertyOf rdf:resource="#reaches"/>
  <rdfs:range rdf:resource="#Host"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#connectsTo"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#forwardsTo"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#forwardsTo">
  <rdfs:domain rdf:resource="#Host"/>
  <rdfs:range rdf:resource="#Host"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#runsProduct">
  <rdfs:domain rdf:resource="#Component"/>
  <rdfs:range rdf:resource="#Product"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#affects">
  <rdfs:domain rdf:resource="#Vulnerability"/>
  <rdfs:range rdf:resource="#Product"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasWeakness">
  <rdfs:domain rdf:resource="#Vulnerability"/>
  <rdfs:range rdf:resource="#Weakness"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#childOf">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#Weakness"/>
  <rdfs:range rdf:resource="#Weakness"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#canPrecede">
  <rdfs:domain rdf:resource="#Weakness"/>
  <rdfs:range rdf:resource="#Weakness"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#targetedBy">
  <rdfs:domain rdf:resource="#Weakness"/>
  <rdfs:range rdf:resource="#AttackPattern"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#patternPrecedes">
  <rdfs:domain rdf:resource="#AttackPattern"/>
  <rdfs:range rdf:resource="#AttackPattern"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#onComponent">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Finding"/>
  <rdfs:range rdf:resource="#Component"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ofVulnerability">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Finding"/>
  <rdfs:range rdf:resource="#Vulnerability"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#onHost">
  <rdfs:domain rdf:resource="#Finding"/>
  <rdfs:range rdf:resource="#Host"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#onComponent"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#hostedOn"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#exhibits">
  <rdfs:domain rdf:resource="#Finding"/>
  <rdfs:range rdf:resource="#Weakness"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#ofVulnerability"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#hasWeakness"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#exhibits"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#childOf"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#exposedTo">
  <rdfs:domain rdf:resource="#Finding"/>
  <rdfs:range rdf:resource="#AttackPattern"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#exhibits"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#targetedBy"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#enables">
  <rdfs:domain rdf:resource="#Finding"/>
  <rdfs:range rdf:resource="#Finding"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#enablesByWeakness">
  <rdfs:subPropertyOf rdf:resource="#enables"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#enablesByPattern">
  <rdfs:subPropertyOf rdf:resource="#enables"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#enablesByPrivilege">
  <rdfs:subPropertyOf rdf:resource="#enables"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#enablesByPivot">
  <rdfs:subPropertyOf rdf:resource="#enables"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#compromises">
  <rdfs:domain rdf:resource="#Finding"/>
  <rdfs:range rdf:resource="#Component"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#attackVector">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Vulnerability"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#privilegesRequired">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Vulnerability"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#userInteraction">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Vulnerability"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#confImpact">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Vulnerability"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#integImpact">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Vulnerability"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#availImpact">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Vulnerability"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#cvssBase">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Vulnerability"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#epssScore">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Vulnerability"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#knownExploited">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Vulnerability"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#assetValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Component"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#cpeName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Product"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Asset">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#WebApplication">
  <rdfs:subClassOf rdf:resource="#Asset"/>
</owl:Class>

<owl:Class rdf:about="#Host">
  <rdfs:subClassOf rdf:resource="#Asset"/>
</owl:Class>

<owl:Class rdf:about="#NetworkZone">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Component">
  <rdfs:subClassOf rdf:resource="#Asset"/>
</owl:Class>

<owl:Class rdf:about="#EdgeComponent">
  <rdfs:subClassOf rdf:resource="#Component"/>
</owl:Class>

<owl:Class rdf:about="#RuntimeComponent">
  <rdfs:subClassOf rdf:resource="#Component"/>
</owl:Class>

<owl:Class rdf:about="#ApplicationComponent">
  <rdfs:subClassOf rdf:resource="#Component"/>
</owl:Class>

<owl:Class rdf:about="#LibraryComponent">
  <rdfs:subClassOf rdf:resource="#Component"/>
</owl:Class>

<owl:Class rdf:about="#DataStoreComponent">
  <rdfs:subClassOf rdf:resource="#Component"/>
</owl:Class>

<owl:Class rdf:about="#AuxiliaryService">
  <rdfs:subClassOf rdf:resource="#Component"/>
</owl:Class>

<owl:Class rdf:about="#AdminComponent">
  <rdfs:subClassOf rdf:resource="#Component"/>
</owl:Class>

<owl:Class rdf:about="#Product">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Vulnerability">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Weakness">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#AttackPattern">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Finding">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#ExposedHost">
  <rdfs:subClassOf rdf:resource="#Host"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Host"/>
        <owl:Restriction>
          <owl:onProperty>
            <rdf:Description>
              <owl:inverseOf rdf:resource="#connectsTo"/>
            </rdf:Description>
          </owl:onProperty>
          <owl:someValuesFrom rdf:resource="#NetworkZone"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#FootholdGranting">
  <rdfs:subClassOf rdf:resource="#Vulnerability"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Vulnerability"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#confImpact"/>
          <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">H</owl:hasValue>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#integImpact"/>
          <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">H</owl:hasValue>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#LocalVulnerability">
  <rdfs:subClassOf rdf:resource="#Vulnerability"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Vulnerability"/>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <owl:Restriction>
              <owl:onProperty rdf:resource="#attackVector"/>
              <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">L</owl:hasValue>
            </owl:Restriction>
            <owl:Restriction>
              <owl:onProperty rdf:resource="#attackVector"/>
              <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</owl:hasValue>
            </owl:Restriction>
          </owl:unionOf>
        </owl:Class>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#RemoteVulnerability">
  <rdfs:subClassOf rdf:resource="#Vulnerability"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Vulnerability"/>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <owl:Restriction>
              <owl:onProperty rdf:resource="#attackVector"/>
              <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N</owl:hasValue>
            </owl:Restriction>
            <owl:Restriction>
              <owl:onProperty rdf:resource="#attackVector"/>
              <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A</owl:hasValue>
            </owl:Restriction>
          </owl:unionOf>
        </owl:Class>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#FootholdFinding">
  <rdfs:subClassOf rdf:resource="#Finding"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Finding"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#ofVulnerability"/>
          <owl:someValuesFrom rdf:resource="#FootholdGranting"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#EntryPointFinding">
  <rdfs:subClassOf rdf:resource="#Finding"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Finding"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#ofVulnerability"/>
          <owl:someValuesFrom rdf:resource="#RemoteVulnerability"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#onHost"/>
          <owl:someValuesFrom rdf:resource="#ExposedHost"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

